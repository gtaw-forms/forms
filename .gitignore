discord-bot/debug-testing-scripts/
# functions (Firebase Cloud Functions API/proxy endpoints)
# The old blanket `functions` ignore hid deployed modules that functions/index.js
# imports (src/utils/rateLimit.js, src/auth/ucpClient.js, src/utils/imageType.js),
# so a fresh clone could not deploy. functions/.gitignore still keeps
# node_modules/ and .env out of git.
