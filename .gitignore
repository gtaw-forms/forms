# tools
tools/*
# deploy-critical bot tooling IS tracked (documented in CLAUDE.md → Bot Deployment)
!tools/deploy-bot.mjs
!tools/check-bot-imports.mjs
# morgue street-bubble coverage checker (read-only probe; reused by the feature)
!tools/morgue-street-coverage.mjs
# targeted autopsy duplicate marker (see tools/mark-autopsy-duplicate.mjs)
!tools/mark-autopsy-duplicate.mjs
# re-arm a parked (caseState=skipped) autopsy request for intake re-run
!tools/redrive-mass-request.mjs
# read-only rehearsal of a web mass autopsy request (parser + ME preview, no writes)
!tools/rehearse-mass-request.mjs
# saved-report view audit reader (migration UI audit trail)
!tools/report-view-log.mjs
# mirror deployed scheduledReports into the VPS feed store (live-feed backfill)
!tools/mirror-scheduled-reports.mjs
# Cloud Functions gen2 post-incident triage (are containers starting?)
!tools/probe-functions.mjs
# authenticated smoke test of the image upload proxy (bot-style ID token)
!tools/verify-upload-proxy.mjs
tools/service-account.json
