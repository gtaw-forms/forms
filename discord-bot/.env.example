# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# Firebase Realtime Database URL (from Firebase Console)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Firebase Admin Key Path (relative to discord-bot/ or absolute)
FIREBASE_ADMIN_KEY_PATH=../firebase-admin-key.json

# Guild ID for testing (leave blank for global commands)
GUILD_ID=

# Discord User ID of the bot owner (for /restart and future admin commands)
BOT_OWNER_ID=your_discord_user_id_here

# ── Forum / Report Deployment ──

# Forum base URL (e.g. http://lspd.gta.world)
FORUM_BASE_URL=http://lspd.gta.world

# Default forum credentials (used by /report deploy; can also login via /report login modal)
FORUM_USERNAME=
FORUM_PASSWORD=

# Run browser in headless mode (true = invisible, false = visible for debugging)
HEADLESS=true

# Enable verbose logging from the browser page
DEBUG=false
