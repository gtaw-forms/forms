# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# Firebase Realtime Database URL (from Firebase Console)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Firebase Admin Key Path (relative to discord-bot/ or absolute)
FIREBASE_ADMIN_KEY_PATH=../firebase-admin-key.json

# Guild ID for testing (leave blank for global commands)
GUILD_ID=

# Discord User ID of the bot owner (for /restart and future admin commands)
BOT_OWNER_ID=your_discord_user_id_here

# ── Forum / Report Deployment ──

# Forum base URL (e.g. http://lspd.gta.world)
FORUM_BASE_URL=http://lspd.gta.world

# Default forum credentials (used by /report deploy; can also login via /report login modal)
FORUM_USERNAME=
FORUM_PASSWORD=

# Alternative forum for PM deployment (e.g. LSPD forum for coroner emails)
# Uses DIFFERENT credentials from the base forum
FORUM_LSPD_URL=http://lspd.gta.world
FORUM_LSPD_USERNAME=
FORUM_LSPD_PASSWORD=

# LSSD forum for PM deployment (separate from LSPD)
FORUM_LSSD_URL=http://lssd.gta.world
FORUM_LSSD_USERNAME=
FORUM_LSSD_PASSWORD=

# SADCR forum for PM deployment
FORUM_SADCR_URL=http://sadcr.gta.world
FORUM_SADCR_USERNAME=
FORUM_SADCR_PASSWORD=

# DAO forum for PM deployment
FORUM_DAO_URL=https://lsda.gta.world
FORUM_DAO_USERNAME=
FORUM_DAO_PASSWORD=

# Run browser in headless mode (true = invisible, false = visible for debugging)
HEADLESS=true

# Enable verbose logging from the browser page
DEBUG=false

# Discord webhook URL for auto-deploy notifications
# Leave blank to disable notifications
DEPLOY_WEBHOOK_URL=

# Discord channel ID for bot log/debug/crash messages
# The bot sends startup, error, and crash reports here
# Also receives non-essential startup notifications by default
BOT_LOG_CHANNEL_ID=

# Medical Records: dry-run mode for replies (true = fill form but DON'T submit)
# Set to false when you're ready for live replies
DRY_REPLY=true

# Medical Record dedicated dry-run (takes precedence over DRY_REPLY when set)
# Logs full BBCode to debug-medical-record-bbcode.txt for validation
MEDICAL_RECORD_DRY_RUN=true

# Death Record Draft Review — Discord channel ID where CK death record
# drafts are sent for approval before being posted to the forum.
# Defaults to DASHBOARD_CHANNEL_ID if not set.
# DEATH_RECORD_DRAFT_CHANNEL_ID=

# Dry-run mode for forum topic posting (true = simulate, don't actually post)
# Set to false when you're ready for live posting
DRY_POST=true

# Dry-run mode for Autopsy Case Management replies (true = simulate, don't actually post)
# Set to false when you're ready for live autopsy posting
AUTOPSY_DRY_RUN=true

# Dry-run mode for Autopsy LSSD cross-posting (searches LSSD f=2263 by OOC name, replies)
# Requires LSSD forum credentials to be configured
AUTOPSY_LSSD_DRY_RUN=true

# Dry-run mode for auto-generated Coroner Emails (true = simulate, log BBCode, never send PMs)
# Set CORONER_EMAIL_DRY_RUN=false and add forum URLs to CORONER_EMAIL_ALLOWED to enable live sending
CORONER_EMAIL_DRY_RUN=true
# Comma-separated list of allowed forum base URLs for live coroner email sends (e.g. https://lspd.gta.world,https://lssd.gta.world)
# CORONER_EMAIL_ALLOWED=

# DEV_TEST: force all autopsy assignments to Alyson Frost (for testing only)
# AUTOPSY_DEV_TEST=true

# ── Autopsy Request Monitor ──

# Check interval in milliseconds for the autopsy request monitor (default 300000 = 5 min)
# AUTOPSY_MONITOR_INTERVAL=300000

# ── Morgue REST API ──

# Port for the standalone morgue REST API server (default 3001)
# MORGUE_API_PORT=3001

# Comma-separated list of API keys for third-party morgue access
# NOTE: These keys are READ-ONLY (GET + POST only). PUT/DELETE is blocked.
# Generate keys with: node -e "console.log('pmc_morgue_' + require('crypto').randomBytes(16).toString('hex'))"
# Share one key per third-party tool. Revoke by removing from this list and restarting.
# Keys must be sent via x-api-key header — ?key= query param is no longer supported.
# MORGUE_API_KEYS=pmc_morgue_abc123,pmc_morgue_def456

# Comma-separated list of write/allowed API keys (PUT/DELETE permitted)
# Only for internal use (PowerShell logger scripts, admin tools).
# Every write operation is logged prominently to the Discord webhook.
# These keys also work for GET/POST requests (they are a superset).
# MORGUE_WRITE_API_KEYS=pmc_morgue_write_xxx,pmc_morgue_write_yyy

# Discord webhook URL for morgue API activity logs and security alerts
# Every request is logged here (batched every 30s).
# Suspicious request alerts (RCE attempts, scanners, path traversal) are sent immediately.
# Leave blank to disable Discord logging entirely.
# MORGUE_API_LOG_WEBHOOK=https://discord.com/api/webhooks/...
