# ═══════════════════════════════════════════════════════════════
# PHMC Discord Bot — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# The bot loads .env on startup (no dotenv dependency — manual parser).
# ═══════════════════════════════════════════════════════════════

# ── Discord ───────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here     # Bot token from Discord Developer Portal
DISCORD_TOKEN=                            # Optional: separate token used for REST-API DMs to the owner (forumClient notifyOwner)
GUILD_ID=                                 # Server ID (leave blank for global commands)
BOT_OWNER_ID=your_discord_user_id_here    # Discord user ID for owner-only commands
BOT_LOG_CHANNEL_ID=                       # Channel for deploy progress, errors, crash reports
DASHBOARD_CHANNEL_ID=                     # Channel for the live system status dashboard embed
DEATH_RECORD_DRAFT_CHANNEL_ID=            # Channel for CK death record draft approvals

# ── Firebase ───────────────────────────────────────────────────
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_ADMIN_KEY_PATH=../firebase-admin-key.json   # Relative to discord-bot/ or absolute

# ── PHMC Forum (phpBB) ─────────────────────────────────────────
FORUM_BASE_URL=https://phmc.gta.world       # Primary forum (topic/reply posting)
FORUM_USERNAME=                             # Bot poster account username
FORUM_PASSWORD=                             # Bot poster account password

# ── LSPD Forum (PM deployment + autopsy crosspost) ─────────────
FORUM_LSPD_URL=https://lspd.gta.world
FORUM_LSPD_USERNAME=
FORUM_LSPD_PASSWORD=

# ── LSSD Forum (autopsy crosspost) ─────────────────────────────
FORUM_LSSD_URL=https://lssd.gta.world
FORUM_LSSD_USERNAME=
FORUM_LSSD_PASSWORD=

# ── SADCR Forum (PM deployment) ────────────────────────────────
FORUM_SADCR_URL=https://sadcr.gta.world
FORUM_SADCR_USERNAME=
FORUM_SADCR_PASSWORD=

# ── DAO Forum (PM deployment) ──────────────────────────────────
FORUM_DAO_URL=https://lsda.gta.world
FORUM_DAO_USERNAME=
FORUM_DAO_PASSWORD=

# ── Browser / Playwright ──────────────────────────────────────
HEADLESS=true           # Run Playwright headless (false to watch browser)
DEBUG=false             # Verbose Playwright console logging

# ── Global Deploy Flag ─────────────────────────────────────────
DRY_RUN=true            # Master dry-run — when true, ALL deploy types skip submission

# ── Per-Type Dry-Run Flags ─────────────────────────────────────
# Each type has a dedicated flag. All default true for safety.
# Set a flag to false only after testing the corresponding flow.
DRY_POST=true           # Topic posting (new forum threads)
DRY_REPLY=true          # Reply posting (case management, medical records)
AUTOPSY_DRY_RUN=true    # Autopsy Case Management replies
MEDICAL_RECORD_DRY_RUN=true  # Medical record forum replies
CORONER_EMAIL_DRY_RUN=true   # Coroner email PMs
CORONER_EMAIL_ALLOWED=        # Comma-separated forum URLs allowed for LIVE coroner email sends (safety whitelist)
MEDICAL_RECORD_ALLOWED=       # Comma-separated forum URLs allowed for LIVE medical-record sends (safety whitelist)
# AUTOPSY_LSSD_DRY_RUN=true  # (not currently implemented — LSSD always uses its own flag)

# ── Autopsy System ─────────────────────────────────────────────
# AUTOPSY_MONITOR_INTERVAL=60000   # Poll interval (ms) for scanning f=265 (default 60000)
# RECOVERY_HEARTBEAT_INTERVAL_MS=600000  # Recovery/heartbeat sweep cadence (ms) (default 10 min)
# AUTOPSY_DEV_TEST=true            # Force all ME assignments to a single user (dev only)

# ── Morgue REST API ────────────────────────────────────────────
# MORGUE_API_PORT=3001             # Port for the Express server (default 3001)
# MORGUE_API_KEYS=                 # Read-only keys (GET, POST). Share one per third-party tool.
# MORGUE_WRITE_API_KEYS=           # Write-capable keys (PUT, DELETE). Internal use only.
# MORGUE_API_LOG_WEBHOOK=          # Discord webhook for API request logs + security alerts
# MORGUE_API_TRUSTED_IPS=          # Comma-separated IPs exempt from strike/ban logic (loopback always trusted)
# MORGUE_BAN_THRESHOLD=2           # Ambiguous suspicious attempts before an IP is permanently banned (default 2)
#                                  # Obvious scanner/CVE probes (label CVE-*/SCAN-*) are banned on first hit.
#                                  # Cycling >=12 DISTINCT unknown API paths within 10 min also bans instantly
#                                  # (SCAN-path-enumeration).
#                                  # Bans + strike counts persist to data/ban-state.json and survive restarts.
#
# Generate a key: node -e "console.log('pmc_morgue_' + require('crypto').randomBytes(16).toString('hex'))"
# Send keys via x-api-key header. ?key= query param is NOT supported.

# ── Facebrowser (Face) Public Death Records ──────────────────────
FACE_API_KEY=                   # Face page API key (from Face dashboard, max 2 per user)
FACE_PAGE_ID=                   # PHMC Public Death Records page id — find/set via: node debug-testing-scripts/face-find-page.mjs --set
FACE_DRAFT_CHANNEL_ID=          # Channel for Face post review drafts (falls back to DEATH_RECORD_DRAFT_CHANNEL_ID)
FACE_DRY_RUN=true               # Dry-run — when true, approving a Face draft simulates instead of posting
FACE_PUBLISH_DELAY_HOURS=48     # Delay (hours) before a scheduled Face post auto-publishes (default 48; 0 = publish at next sweep)

# ── Autopsy Monitoring ─────────────────────────────────────────
# AUTOPSY_OVERDUE_HOURS=48      # Fallback wait limit (hours) when a request has no PK/CK type (default 48)
# AUTOPSY_OVERDUE_HOURS_CK=72   # CK requests: alert the owner after this many hours pending (default 72 = 3 days)
# AUTOPSY_OVERDUE_HOURS_PK=120  # PK requests: alert the owner after this many hours pending (default 120 = 5 days)

# ── Autopsy System ─────────────────────────────────────────────
# DEV TEST MODE — toggled live via /enable-dev-autopsy (owner only). When true,
# EVERY new autopsy (fair rotation, surge, and supervised ASSIGNED: markers)
# is assigned to AUTOPSY_DEV_TEST_ME. Everything else runs normally.
# AUTOPSY_DEV_TEST=false
# AUTOPSY_DEV_TEST_ME=Alyson Frost

# ── Webhooks ───────────────────────────────────────────────────
DEPLOY_WEBHOOK_URL=                 # Discord webhook for deploy status notifications
ASSIGNMENT_WEBHOOK_URL=             # Discord webhook for autopsy-assignment pings (tags the assigned ME)
FORWARD_WEBHOOK_URL=                # Webhook that autopsy assignments are auto-forwarded to (notifyAssignment / /forward-autopsy-notify)

# ── AdGuard Home Metrics Dashboard ─────────────────────────────
# Posts a live metrics embed (queries/blocked/top domains/clients) to a channel.
# AGH runs on the VPS; the bot reaches its control API over the tailnet. Set
# AGH_PASSWORD (AGH_USER defaults to Frost) or the manager logs a warning and skips.
AGH_API_URL=http://100.84.161.69:3000   # AGH control API base (tailnet IP:3000)
AGH_USER=Frost                           # AGH admin username
AGH_PASSWORD=                            # AGH admin password (required for dashboard)

# ── Autopsy Requester Completion Webhooks ──────────────────────
# Fired when an autopsy completes for a CASELINK-posted request. One webhook
# per faction — blank var = faction skipped silently (DAO/LSPD intentionally
# blank until each faction has a notification channel; code is ready).
AUTOPSY_REQUESTER_WEBHOOK_LSSD=
AUTOPSY_REQUESTER_WEBHOOK_SADCR=
AUTOPSY_REQUESTER_WEBHOOK_DAO=
AUTOPSY_REQUESTER_WEBHOOK_LSPD=
# Staging override: when true, ALL factions route to TEST_URL instead and every
# send is logged with [TEST-OVERRIDE]. Only enable on the test environment.
AUTOPSY_REQUESTER_WEBHOOK_TEST_MODE=false
AUTOPSY_REQUESTER_WEBHOOK_TEST_URL=
