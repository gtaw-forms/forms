{
  "name": "phmc-app-forms",
  "version": "0.1.0",
  "homepage": "https://phmc-forms.github.io/forms",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@sentry/cli": "^2.43.0",
    "@sentry/react": "^9.12.0",
    "@sentry/tracing": "^7.120.3",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "bootstrap": "^5.3.3",
    "dom-to-image": "^2.6.0",
    "firebase": "^11.9.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.9",
    "react-bootstrap-typeahead": "^7.0.0-rc.5",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.10.1",
    "react-snowfall": "^2.2.0",
    "react-tsparticles": "^2.12.2",
    "tsparticles": "^3.8.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "react-scripts build && npm run sentry:sourcemaps",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postbuild": "git add . && git commit && git push origin source",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org phmc-gtaw --project javascript-react ./build && sentry-cli sourcemaps upload --org phmc-gtaw --project javascript-react ./build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-transform-private-property-in-object": "^7.25.9",
    "ajv": "^7.2.4",
    "eslint": "^9.17.0",
    "gh-pages": "^6.2.0"
  }
}
