# Cloud Functions — environment (functions/.env)
# Copied by the Firebase CLI into the deployed function runtime.
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# The functions proxy calls to your VPS morgue-api (the web app never talks to
# the VPS directly).

# Base URL of your morgue-api. Off-box callers use port 80 (nginx proxies /api/
# to 127.0.0.1:3001); port 3001 itself is firewalled off the public internet.
MORGUE_API_URL=http://88.208.243.254

# A valid morgue-api READ key (functions proxy reads to the VPS).
# Generate: node -e "console.log('pmc_morgue_' + require('crypto').randomBytes(16).toString('hex'))"
MORGUE_API_KEY=

# A valid morgue-api WRITE key — only needed if a function performs PUT/DELETE
# against the VPS (e.g. deleting records). Optional.
MORGUE_WRITE_API_KEY=

# Discord webhook URLs are NOT env vars here — they live in the PHMC_CONFIG
# Cloud Secret (see docs/CONFIGURATION.md). Set it with:
#   firebase functions:secrets:set PHMC_CONFIG
#
# The image upload proxy reads IMGLINK_API_KEY from that same secret (ImgLink.cc
# account API key, files every upload in the `Coroners` album). Add it to the
# PHMC_CONFIG JSON — do not put it in this file.