{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "appMetadata": {
      ".read": true
    },
    "translations": {
      ".read": true,
      "$formId": {
        "$langCode": {
          ".write": false
        }
      }
    },
    "forms": {
      ".read": true
    },
    "selectOptions": {
      ".read": true
    },
    "verified_locations": {
      ".read": true
    },
    "lscc": {
      "keywords": {
        ".read": true
      },
      "injuries": {
        ".read": true
      }
    },
    "presence": {
      "$sessionId": {
        ".read": true,
        ".write": true
      }
    },
    "analytics": {
      "visitors": {
        "$date": {
          "$sessionId": {
            ".read": true,
            ".write": true
          }
        }
      }
    },
    "newSavedReports": {
      "$user_id": {
        ".read": true,
        ".indexOn": "timestamp"
      }
    },
    "savedReports": {
      "$user_id": {
        ".read": true,
        ".indexOn": "timestamp"
      }
    },
    "factions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "webhooks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "deathRecordDrafts": {
      ".indexOn": ["needsMorgue", "deploying", "needsBetterMorgue", "verifyAfter", "status"]
    },
    "morgue-records": {
      ".read": false,
      ".indexOn": "lastUpdated"
    },
    "autopsy-requested": {
      ".indexOn": ["oocName", "name", "lssdCrosspostStatus", "lspdCrosspostStatus", "lssdTopicId", "lspd-acknowledge-reply", "lssd-acknowledge-reply", "phmc-acknowledge-reply", "sadcr-acknowledge-reply", "dao-acknowledge-reply"]
    },
    "dev-reports": {
      ".read": true,
      ".write": true
    },
    "dev-reports-bbcode": {
      ".read": true,
      ".write": true
    }
  }
}
