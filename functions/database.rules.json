{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "appMetadata": {
      ".read": true
    },
    "forms": {
      ".read": true
    },
    "verified_locations": {
      ".read": true
    },
    "lscc": {
      "keywords": {
        ".read": true
      },
      "injuries": {
        ".read": true
      }
    },
    "newSavedReports": {
      "$user_id": {
        ".read": true,
        ".indexOn": "timestamp"
      }
    },
    "savedReports": {
      "$user_id": {
        ".read": true,
        ".indexOn": "timestamp"
      }
    },
    "factions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "webhooks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "deathRecordDrafts": {
      ".indexOn": "needsMorgue"
    },
    "morgue-records": {
      ".read": false,
      ".indexOn": "lastUpdated"
    },
    "autopsy-requested": {
      ".indexOn": ["oocName", "name", "lssdCrosspostStatus", "lssdTopicId", "lspdAck", "lssdAck", "phmcAck"]
    },
    "dev-reports": {
      ".read": true,
      ".write": true
    },
    "dev-reports-bbcode": {
      ".read": true,
      ".write": true
    }
  }
}
