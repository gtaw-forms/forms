#!/bin/sh
# Pre-commit hook — NEVER commit Discord webhook URLs.
# A webhook URL (discord.com/api/webhooks/<id>/<token>) IS the secret:
# anyone holding it can post as the webhook and delete it. This repo is
# public, so a committed URL is a leaked credential the moment you push.
#
# Blocks any staged line containing a webhook URL with a numeric channel id.
# Doc placeholders like https://discord.com/api/webhooks/.../... (no digits)
# still pass. Webhook destinations must come from env / secrets at runtime.
#
# Enable once per clone:  git config core.hooksPath .githooks

if git rev-parse --verify HEAD >/dev/null 2>&1; then
    AGAINST=HEAD
else
    AGAINST=4b825dc642cb6eb9a060e54bf8d69288fbee4904
fi

LEAKS=$(git diff --cached --unified=0 "$AGAINST" -- . \
    | grep -E "^\+[^+]" \
    | grep -E "discord\.com/api/webhooks/[0-9]" || true)

if [ -n "$LEAKS" ]; then
    echo ""
    echo "BLOCKED: staged changes contain a Discord webhook URL."
    echo "Webhook URLs are credentials and must NEVER be committed (see AGENTS.md hard rule)."
    echo "Use env vars / PHMC_CONFIG / RTDB at runtime instead, then unstage the URL."
    echo ""
    echo "$LEAKS" | cut -c1-120
    echo ""
    exit 1
fi

exit 0
